rules_version = '2';
// Lakwatsa Firestore rules. Test against the emulator before publishing.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Current app uses /users/{uid}/... and uppercase Activity statuses.
    function activityPath(uid, activityId) {
      return /databases/$(database)/documents/users/$(uid)/activities/$(activityId);
    }
    function activityItemPath(uid, activityId, itemId) {
      return /databases/$(database)/documents/users/$(uid)/activities/$(activityId)/items/$(itemId);
    }
    function checkPath(uid, activityId, checkId) {
      return /databases/$(database)/documents/users/$(uid)/activities/$(activityId)/checks/$(checkId);
    }
    function beforeOrReturnCheck(checkId) {
      return checkId == 'before_activity' || checkId == 'return';
    }
    function fromStatus(checkId) {
      return checkId == 'before_activity' ? 'UPCOMING' : 'ACTIVE';
    }
    function toStatus(checkId) {
      return checkId == 'before_activity' ? 'ACTIVE' : 'COMPLETED';
    }
    function checkType(checkId) {
      return checkId == 'before_activity' ? 'BEFORE_ACTIVITY' : 'RETURN';
    }
    function transitionsWithCheck(uid, activityId, checkId) {
      return beforeOrReturnCheck(checkId)
        && get(activityPath(uid, activityId)).data.status == fromStatus(checkId)
        && getAfter(activityPath(uid, activityId)).data.status == toStatus(checkId);
    }
    function hasActivityItemState(d) {
      return d.keys().hasAll(['itemCount', 'itemRevision', 'itemManifest'])
        && d.itemCount is int && d.itemCount >= 1 && d.itemCount <= 200
        && d.itemRevision is int && d.itemRevision >= 0
        && d.itemManifest is map
        && d.itemManifest.size() == d.itemCount;
    }
    function hasActivityItemMutation(d) {
      return d.keys().hasAll(['itemMutationId', 'itemMutationType'])
        && d.itemMutationId is string && d.itemMutationId.size() > 0
        && d.itemMutationType in ['ADD', 'REMOVE'];
    }
    function hasNoActivityItemMutation(d) {
      return !d.keys().hasAll(['itemMutationId'])
        && !d.keys().hasAll(['itemMutationType']);
    }
    function validActivityDocument(d) {
      return d.keys().hasAll([
          'listId', 'name', 'type', 'activityDate', 'startAt', 'endAt',
          'reminderEnabled', 'reminderMinutes', 'status', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'listId', 'name', 'type', 'activityDate', 'startAt', 'endAt',
          'reminderEnabled', 'reminderMinutes', 'status', 'createdAt', 'updatedAt',
          'itemCount', 'itemRevision', 'itemManifest',
          'itemMutationId', 'itemMutationType'
        ])
        && hasActivityItemState(d)
        && (hasActivityItemMutation(d) || hasNoActivityItemMutation(d))
        && d.listId is string && d.name is string
        && d.name.size() > 0 && d.name.size() <= 100
        && d.type is string && d.type.size() > 0 && d.type.size() <= 60
        && d.activityDate is timestamp && d.startAt is timestamp
        && d.endAt is timestamp && d.endAt > d.startAt
        && d.reminderEnabled is bool
        && d.reminderMinutes is int
        && d.reminderMinutes >= 0 && d.reminderMinutes <= 1440
        && d.status in ['UPCOMING', 'ACTIVE', 'COMPLETED']
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    function metadataOnly(changed) {
      // Reject non-metadata updates before evaluating the field validators below.
      // This keeps unrelated Activity mutations well below the rules expression cap.
      return (
          (resource.data.status == 'UPCOMING'
            && changed.hasOnly([
              'name', 'type', 'activityDate', 'startAt', 'endAt',
              'reminderEnabled', 'reminderMinutes', 'updatedAt'
            ]))
          || (resource.data.status == 'ACTIVE'
            && changed.hasOnly([
              'name', 'type', 'endAt',
              'reminderEnabled', 'reminderMinutes', 'updatedAt'
            ]))
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 60
        && request.resource.data.activityDate is timestamp
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.reminderEnabled is bool
        && request.resource.data.reminderMinutes is int
        && request.resource.data.reminderMinutes >= 0
        && request.resource.data.reminderMinutes <= 1440
        && request.resource.data.updatedAt is timestamp;
    }
    function manifestAddsOnlyItem(beforeData, afterData, itemId) {
      return afterData.itemManifest.size() == beforeData.itemManifest.size() + 1
        && afterData.itemManifest.diff(beforeData.itemManifest)
          .affectedKeys() == [itemId].toSet();
    }
    function manifestRemovesOnlyItem(beforeData, afterData, itemId) {
      return afterData.itemManifest.size() == beforeData.itemManifest.size() - 1
        && afterData.itemManifest.diff(beforeData.itemManifest)
          .affectedKeys() == [itemId].toSet();
    }
    function beforeDraftTracksRemoval(uid, activityId, itemId) {
      let draftPath = checkPath(uid, activityId, 'draft_before_activity');
      return !exists(draftPath)
        || (existsAfter(draftPath)
          && getAfter(draftPath).data.itemRevision
            == request.resource.data.itemRevision
          && !getAfter(draftPath).data.foundMethods.keys().hasAny([itemId]));
    }
    function changesItemState(uid, activityId, changed) {
      let itemId = request.resource.data.get('itemMutationId', '__none__');
      let itemPath = activityItemPath(uid, activityId, itemId);
      // Gate on the mutation-shaped diff before the manifest/document checks.
      return changed.hasOnly([
          'itemCount', 'itemRevision', 'itemManifest',
          'itemMutationId', 'itemMutationType', 'updatedAt'
        ])
        && resource.data.status in ['UPCOMING', 'ACTIVE']
        && request.resource.data.itemRevision == resource.data.itemRevision + 1
        && request.resource.data.updatedAt is timestamp
        && hasActivityItemMutation(request.resource.data)
        && hasActivityItemState(resource.data)
        && hasActivityItemState(request.resource.data)
        && ((request.resource.data.itemMutationType == 'ADD'
            && request.resource.data.itemCount == resource.data.itemCount + 1
            && manifestAddsOnlyItem(resource.data, request.resource.data, itemId)
            && !exists(itemPath) && existsAfter(itemPath)
            && request.resource.data.itemManifest[itemId]
              == getAfter(itemPath).data)
          || (request.resource.data.itemMutationType == 'REMOVE'
            && resource.data.status == 'UPCOMING'
            && resource.data.itemCount > 1
            && request.resource.data.itemCount == resource.data.itemCount - 1
            && manifestRemovesOnlyItem(resource.data, request.resource.data, itemId)
            && beforeDraftTracksRemoval(uid, activityId, itemId)
            && (!exists(itemPath) || !existsAfter(itemPath))));
    }
    function completedCheckMatches(uid, activityId, checkId) {
      let completed = getAfter(checkPath(uid, activityId, checkId)).data;
      return completed.type == checkType(checkId)
        && completed.status == 'COMPLETED'
        && completed.itemCount == resource.data.itemCount
        && completed.itemRevision == resource.data.itemRevision
        && completed.itemIds.toSet() == resource.data.itemManifest.keys().toSet();
    }
    function completesCheck(uid, activityId, checkId, changed) {
      return changed.hasOnly(['status', 'updatedAt'])
        && resource.data.status == fromStatus(checkId)
        && request.resource.data.status == toStatus(checkId)
        && request.resource.data.updatedAt is timestamp
        && hasActivityItemState(resource.data)
        && existsAfter(checkPath(uid, activityId, checkId))
        && completedCheckMatches(uid, activityId, checkId);
    }

    function activityUpdateAllowed(uid, activityId) {
      // Route by status before evaluating unrelated update policies. A check
      // transition must not traverse metadata and Item mutation validators
      // before its own manifest/count verification.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.status == resource.data.status
        ? (metadataOnly(changed)
          || changesItemState(uid, activityId, changed))
        : ((resource.data.status == 'UPCOMING'
            && request.resource.data.status == 'ACTIVE'
            && completesCheck(uid, activityId, 'before_activity', changed))
          || (resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'COMPLETED'
            && completesCheck(uid, activityId, 'return', changed)));
    }
    function validActivityItem(d, itemId) {
      return d.keys().hasAll([
          'itemId', 'itemName', 'category', 'quantity', 'icon',
          'photoUrl', 'qrCode', 'addedDuringActivity', 'createdAt'
        ])
        && d.keys().hasOnly([
          'itemId', 'itemName', 'category', 'quantity', 'icon',
          'photoUrl', 'qrCode', 'addedDuringActivity', 'createdAt'
        ])
        && d.itemId == itemId
        && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 100
        && d.category is string && d.icon is string
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 999
        && (d.photoUrl == null || d.photoUrl is string)
        && (d.qrCode == null || d.qrCode is string)
        && d.addedDuringActivity is bool && d.createdAt is timestamp;
    }
    function initialManifestItemMatches(uid, activityId, itemId, item) {
      let created = getAfter(activityItemPath(uid, activityId, itemId)).data;
      return validActivityItem(created, itemId)
        && created == item
        && !created.addedDuringActivity;
    }
    function hasRealInitialItem(uid, activityId, d) {
      let firstId = d.itemManifest.keys()[0];
      return existsAfter(activityItemPath(uid, activityId, firstId))
        && initialManifestItemMatches(
          uid, activityId, firstId, d.itemManifest[firstId]
        );
    }
    function initialActivityItemCreate(uid, activityId, itemId, d) {
      let parent = getAfter(activityPath(uid, activityId)).data;
      return !exists(activityPath(uid, activityId))
        && existsAfter(activityPath(uid, activityId))
        && hasActivityItemState(parent)
        && parent.status == 'UPCOMING'
        && parent.itemRevision == 0
        && itemId in parent.itemManifest.keys()
        && d == parent.itemManifest[itemId]
        && d.addedDuringActivity == false;
    }
    function trackedActivityItemCreate(uid, activityId, itemId, d) {
      return exists(activityPath(uid, activityId))
        && get(activityPath(uid, activityId)).data.status in ['UPCOMING', 'ACTIVE']
        && getAfter(activityPath(uid, activityId)).data.itemRevision
          == get(activityPath(uid, activityId)).data.itemRevision + 1
        && getAfter(activityPath(uid, activityId)).data.get('itemMutationId', '__none__') == itemId
        && getAfter(activityPath(uid, activityId)).data.get('itemMutationType', 'NONE') == 'ADD'
        && getAfter(activityPath(uid, activityId)).data.itemManifest[itemId] == d
        && ((get(activityPath(uid, activityId)).data.status == 'UPCOMING'
            && d.addedDuringActivity == false)
          || (get(activityPath(uid, activityId)).data.status == 'ACTIVE'
            && d.addedDuringActivity == true));
    }
    function trackedActivityItemDelete(uid, activityId, itemId) {
      return exists(activityPath(uid, activityId))
        && get(activityPath(uid, activityId)).data.status == 'UPCOMING'
        && getAfter(activityPath(uid, activityId)).data.itemRevision
          == get(activityPath(uid, activityId)).data.itemRevision + 1
        && getAfter(activityPath(uid, activityId)).data.get('itemMutationId', '__none__') == itemId
        && getAfter(activityPath(uid, activityId)).data.get('itemMutationType', 'NONE') == 'REMOVE'
        && !(itemId in getAfter(activityPath(uid, activityId)).data.itemManifest.keys());
    }
    function validDraft(d, checkId) {
      return d.keys().hasOnly([
          'type', 'checkType', 'status', 'startedAt', 'foundMethods',
          'itemRevision', 'updatedAt'
        ])
        && d.keys().hasAll([
          'type', 'checkType', 'status', 'startedAt', 'foundMethods',
          'itemRevision', 'updatedAt'
        ])
        && d.type == 'DRAFT' && d.status == 'IN_PROGRESS'
        && d.startedAt is timestamp && d.updatedAt is timestamp
        && d.foundMethods is map && d.foundMethods.size() <= 200
        && d.foundMethods.values().hasOnly(['MANUAL', 'QR'])
        && d.itemRevision is int && d.itemRevision >= 0
        && ((checkId == 'draft_before_activity' && d.checkType == 'BEFORE_ACTIVITY')
          || (checkId == 'draft_return' && d.checkType == 'RETURN'));
    }
    function draftStatusMatches(uid, activityId, checkId, d) {
      let parent = getAfter(activityPath(uid, activityId)).data;
      return hasActivityItemState(parent)
        && d.itemRevision == parent.itemRevision
        && parent.itemManifest.keys().toSet().hasAll(
          d.foundMethods.keys().toSet()
        )
        && ((checkId == 'draft_before_activity' && parent.status == 'UPCOMING')
          || (checkId == 'draft_return' && parent.status == 'ACTIVE'));
    }
    function draftClearedByCompletion(uid, activityId, checkId) {
      return (checkId == 'draft_before_activity'
          && transitionsWithCheck(uid, activityId, 'before_activity'))
        || (checkId == 'draft_return'
          && transitionsWithCheck(uid, activityId, 'return'));
    }
    function validCheckResultManifest(uid, activityId, d) {
      let parent = get(activityPath(uid, activityId)).data;
      let allItems = d.itemIds.toSet();
      let manualItems = d.manualItemIds.toSet();
      let qrItems = d.qrItemIds.toSet();
      let missingItems = d.missingItemIds.toSet();
      return hasActivityItemState(parent)
        && d.itemIds.size() == allItems.size()
        && d.manualItemIds.size() == manualItems.size()
        && d.qrItemIds.size() == qrItems.size()
        && d.missingItemIds.size() == missingItems.size()
        && allItems == parent.itemManifest.keys().toSet()
        && allItems.hasAll(manualItems)
        && allItems.hasAll(qrItems)
        && allItems.hasAll(missingItems)
        && manualItems.intersection(qrItems).size() == 0
        && manualItems.intersection(missingItems).size() == 0
        && qrItems.intersection(missingItems).size() == 0
        && manualItems.size() + qrItems.size() + missingItems.size()
          == allItems.size();
    }
    function validCompletedCheck(d, checkId, uid, activityId) {
      return beforeOrReturnCheck(checkId)
        && d.keys().hasOnly([
          'type', 'startedAt', 'completedAt', 'status', 'itemCount', 'itemRevision',
          'itemIds', 'manualItemIds', 'qrItemIds', 'missingItemIds'
        ])
        && d.keys().hasAll([
          'type', 'startedAt', 'completedAt', 'status', 'itemCount', 'itemRevision',
          'itemIds', 'manualItemIds', 'qrItemIds', 'missingItemIds'
        ])
        && d.type == checkType(checkId) && d.status == 'COMPLETED'
        && d.startedAt is timestamp && d.completedAt is timestamp
        && d.completedAt >= d.startedAt
        && d.itemCount is int && d.itemCount >= 1 && d.itemCount <= 200
        && d.itemRevision is int && d.itemRevision >= 0
        && d.itemIds is list
        && d.manualItemIds is list
        && d.qrItemIds is list
        && d.missingItemIds is list
        && d.itemCount == d.itemIds.size()
        && validCheckResultManifest(uid, activityId, d);
    }

    function validCategoryIcon(icon) {
      return icon is string && icon in [
        'inventory', 'star', 'favorite', 'gift', 'bookmark',
        'electronics', 'laptop', 'phone', 'camera', 'camera_alt',
        'camera_front', 'camera_rear', 'video_camera', 'headphones',
        'charger', 'battery', 'cable', 'keyboard', 'mouse', 'watch',
        'passport', 'id', 'wallet', 'keys', 'luggage', 'backpack',
        'umbrella', 'map', 'beach', 'clothing', 'toiletries', 'medicine',
        'first_aid', 'health', 'documents', 'book', 'school', 'work',
        'notes', 'food', 'drink', 'kitchen', 'home', 'water', 'fitness',
        'sports', 'pets', 'baby', 'tools', 'flashlight',
        'tablet', 'desktop', 'speaker', 'earbuds', 'usb', 'gamepad',
        'calculator', 'pen', 'folder', 'clipboard', 'ticket', 'car',
        'bicycle', 'plane', 'bus', 'train', 'bed', 'laundry', 'soap',
        'brush', 'glasses', 'bottle', 'shopping_bag', 'shopping_cart',
        'coffee', 'camping', 'hiking', 'soccer', 'swimming', 'music',
        'microphone', 'palette', 'lock', 'money', 'receipt', 'calendar',
        'clock', 'sun', 'moon', 'plant'
      ];
    }

    function validCustomItemCategory(d, categoryId) {
      return d.keys().hasOnly(['name', 'icon', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'icon', 'createdAt', 'updatedAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 40
        && d.name == d.name.trim()
        && categoryId == d.name.lower()
        && !(d.name.lower() in [
          'all', 'electronics', 'documents', 'clothing', 'toiletries', 'other'
        ])
        && !(d.name in ['.', '..'])
        && validCategoryIcon(d.icon)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validCustomItemCategoryCreate(d, categoryId) {
      return validCustomItemCategory(d, categoryId)
        && d.updatedAt == d.createdAt;
    }

    function validCustomItemCategoryIconUpdate(categoryId) {
      return validCustomItemCategory(request.resource.data, categoryId)
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['icon', 'updatedAt'])
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }


    match /users/{uid} {
      allow read, write: if owner(uid);
      match /categories/{categoryId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && validCustomItemCategoryCreate(request.resource.data, categoryId);
        // Category names stay immutable because Items store the name snapshot.
        // Custom category icons may be changed independently.
        allow update: if owner(uid)
          && validCustomItemCategoryIconUpdate(categoryId);
        allow delete: if owner(uid);
      }
      match /items/{itemId} {
        // Preserve existing Item create/edit/delete behavior.
        allow read, write: if owner(uid);
      }
      match /lists/{listId} {
        // Preserve existing List create/edit/delete behavior.
        allow read, write: if owner(uid);
        match /items/{itemId} {
          allow read, write: if owner(uid);
        }
      }
      match /activities/{activityId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && validActivityDocument(request.resource.data)
          && request.resource.data.status == 'UPCOMING'
          // With one initial Item, its child document can be verified in the
          // same batch. Further Items use individually tracked mutations.
          && request.resource.data.itemCount == 1
          && request.resource.data.itemRevision == 0
          && hasRealInitialItem(uid, activityId, request.resource.data);
        allow update: if owner(uid)
          && activityUpdateAllowed(uid, activityId);
        // App deletion currently deletes only the parent and leaves subcollections.
        // Do not enable until a safe recursive cleanup flow exists.
        allow delete: if false;
        match /items/{itemId} {
          allow read: if owner(uid);
          // Every Item mutation is paired with the parent Activity item state.
          allow create: if owner(uid) && validActivityItem(request.resource.data, itemId)
            && (initialActivityItemCreate(uid, activityId, itemId, request.resource.data)
              || trackedActivityItemCreate(uid, activityId, itemId, request.resource.data));
          allow update: if false;
          // Removing Items after Before Check would rewrite saved history.
          // The parent count/revision update also makes concurrent removals conflict.
          allow delete: if owner(uid)
            && trackedActivityItemDelete(uid, activityId, itemId);
        }
        match /checks/{checkId} {
          allow read: if owner(uid);
          allow create: if owner(uid)
            && ((validDraft(request.resource.data, checkId)
                && draftStatusMatches(uid, activityId, checkId, request.resource.data))
              || (validCompletedCheck(request.resource.data, checkId, uid, activityId)
                && transitionsWithCheck(uid, activityId, checkId)));
          allow update: if owner(uid)
            && checkId in ['draft_before_activity', 'draft_return']
            && validDraft(request.resource.data, checkId)
            && draftStatusMatches(uid, activityId, checkId, request.resource.data);
          // A draft can be removed only as part of a status transition.
          allow delete: if owner(uid) && draftClearedByCompletion(uid, activityId, checkId);
          match /items/{itemId} {
            // Legacy result rows remain readable. New completed checks store the
            // complete, rules-verifiable result manifest on the check document.
            allow read: if owner(uid);
            allow write: if false;
          }
        }
      }
    }

    // Compatibility: original v2 schema and rules (unchanged).
    function named(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 100; }
    function validItem(d) {
      return d.keys().hasOnly(['name','category','quantity','archived']) && named(d)
        && d.category in ['Electronics','Documents','Clothing','Personal Care','Other']
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 999 && d.archived is bool;
    }
    function validList(d) {
      return d.keys().hasOnly(['name','quantities']) && named(d)
        && d.quantities is map && d.quantities.size() <= 200;
    }
    function validActivity(d) {
      return d.keys().hasOnly(['name','type','status','startsAt','endsAt','reminderMinutes','items','before','returned','draft','draftStartedAt','reminderUpdatedAt'])
        && named(d) && d.type in ['Trip','School','Work','Daily','Other']
        && d.status in ['planned','active','completed','cancelled']
        && d.startsAt is string && d.endsAt is string && d.endsAt > d.startsAt
        && d.reminderMinutes is int && d.reminderMinutes >= 0 && d.reminderMinutes <= 1440
        && d.items is map && d.items.size() > 0 && d.items.size() <= 200
        && d.draft is map && d.draft.keys().hasOnly(d.items.keys())
        && d.draft.values().hasOnly(['manual','qr']);
    }
    function validCheck(c, d) {
      return c is map && c.keys().hasOnly(['startedAt','completedAt','itemIds','found'])
        && c.startedAt is string && c.completedAt is string
        && c.itemIds is list && c.itemIds.toSet() == d.items.keys().toSet()
        && c.found is map && c.found == resource.data.draft;
    }
    match /lakwatsa_v2_users/{uid}/items/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validItem(request.resource.data);
      allow delete: if false;
    }
    match /lakwatsa_v2_users/{uid}/lists/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validList(request.resource.data);
    }
    match /lakwatsa_v2_users/{uid}/activities/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validActivity(request.resource.data)
        && request.resource.data.status == 'planned'
        && request.resource.data.before == null && request.resource.data.returned == null
        && request.resource.data.draft.size() == 0 && request.resource.data.draftStartedAt == null;
      allow update: if owner(uid) && validActivity(request.resource.data)
        && resource.data.status in ['planned','active']
        && request.resource.data.name == resource.data.name
        && request.resource.data.type == resource.data.type
        && request.resource.data.startsAt == resource.data.startsAt
        && request.resource.data.items.diff(resource.data.items).changedKeys().size() == 0
        && request.resource.data.items.diff(resource.data.items).removedKeys().size() == 0
        && (
          (request.resource.data.status == resource.data.status
            && request.resource.data.before == resource.data.before
            && request.resource.data.returned == resource.data.returned)
          || (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (resource.data.status == 'planned' && request.resource.data.status == 'active'
            && validCheck(request.resource.data.before, resource.data)
            && request.resource.data.returned == null && request.resource.data.draft.size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','before','draft','draftStartedAt']))
          || (resource.data.status == 'active' && request.resource.data.status == 'completed'
            && validCheck(request.resource.data.returned, resource.data)
            && request.resource.data.before == resource.data.before && request.resource.data.draft.size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returned','draft','draftStartedAt']))
        );
      allow delete: if false;
    }
  }
}
